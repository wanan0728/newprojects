2. 准备数据库
docker run -d \
  --name pg18 \
  -e POSTGRES_PASSWORD='123456' \
  -p 5432:5432 \
  postgres:18.1-bookworm

docker exec -it pg18 psql -U postgres

CREATE ROLE peter WITH LOGIN PASSWORD '123456';
CREATE DATABASE enterprise_assistant OWNER peter;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
REVOKE ALL ON DATABASE enterprise_assistant FROM PUBLIC;
GRANT CONNECT ON DATABASE enterprise_assistant TO peter;

\c enterprise_assistant
GRANT USAGE, CREATE ON SCHEMA public TO peter;


3. 环境设置，在项目根目录下建立.env
项目上线后要配置到系统变量中，这里的env记得要保密，不要上传到git，或者开发环境。
