# 2. infra 外部系统模块说明
#
# 这个目录（infra）存放所有与外部系统、基础设施集成的代码。
# 主要负责与数据库、缓存、搜索引擎、消息队列等外部组件的连接和交互。
# 将外部系统相关代码集中在这里，便于管理和替换。

app/
├── infra/                               # 基础设施模块
│   ├── db/                              # 数据库相关模块
│   │   ├── base.py                   (2.1)  # 数据库模型基类，所有模型都继承这个
│   │   ├── engine.py                 (2.2)  # 数据库引擎创建，管理连接池
│   │   ├── session.py                (2.3)  # 数据库会话工厂，创建会话实例
│   │   └── deps.py                   (2.4)  # 数据库依赖，在请求中获取会话
│   │
│   ├── redis_client.py               (2.5)  # Redis客户端，用于缓存、限流等
│   │
│   ├── elasticsearch_client.py       (2.6)  # Elasticsearch客户端，用于全文搜索
│   │
│   └── celery/                             # Celery分布式任务队列模块
│       └── celery_app.py             (2.7)  # Celery应用配置，定义异步任务

# 各模块职责说明：
# 
# 2.1 base.py:        提供所有数据库模型的基类，统一模型行为
# 2.2 engine.py:      创建和管理数据库连接池，控制连接数量
# 2.3 session.py:     创建会话工厂，用于生成数据库会话
# 2.4 deps.py:        FastAPI依赖，自动获取和清理数据库会话
# 2.5 redis_client.py: 提供Redis连接，用于缓存、限流、分布式锁
# 2.6 elasticsearch_client.py: 提供ES连接，用于复杂搜索
# 2.7 celery_app.py:  配置Celery，处理耗时任务（邮件、报表等）